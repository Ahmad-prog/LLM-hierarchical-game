# Copy to .env and fill in. Only needed to run new games, not to reproduce the numbers.
OPENROUTER_API_KEY=sk-or-...
# The manager pays for every token it spends on sanctions (as in the paper). Set to 0 to disable.
HG_SANCTION_COST=1
# For the open-model track: the OpenAI-compatible vLLM endpoint and the served model name
HG_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
HG_LOCAL_MODEL=openai/gpt-oss-120b
